<ui:FluentWindow xmlns:local="clr-namespace:EHUploader" x:Class="EHUploader.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="EH 上传助手"
                 Width="1180" Height="800" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/EHUploader;component/icon.png">
    <ui:FluentWindow.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </ui:FluentWindow.TaskbarItemInfo>
    <ui:FluentWindow.Resources>
        <Style x:Key="NavButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LinkTitle" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="WorkMenu" x:Shared="False">
            <MenuItem Header="复制日文标题" Tag="jp" Click="Copy_Click"/>
            <MenuItem Header="复制英文标题" Tag="en" Click="Copy_Click"/>
            <MenuItem Header="复制作者" Tag="author" Click="Copy_Click"/>
            <MenuItem Header="复制社团" Tag="circle" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="复制链接" Tag="link" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="{Binding ExcludeMenuText}" Click="Exclude_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="GalleryMenu" x:Shared="False">
            <MenuItem Header="复制日文标题" Tag="jp" Click="Copy_Click"/>
            <MenuItem Header="复制英文标题" Tag="en" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="复制画廊链接" Tag="link" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="在网站上提议改名…" Click="Retitle_Click" ToolTip="已发布画廊的标题不能直接改，只能走网站的改名投票"/>
        </ContextMenu>
        <ContextMenu x:Key="CommentMenu" x:Shared="False">
            <MenuItem Header="复制评论内容" Tag="comment" Click="Copy_Click"/>
            <MenuItem Header="复制评论者" Tag="commenter" Click="Copy_Click"/>
        </ContextMenu>
        <!-- 只读、无边框的 TextBox：看起来像普通文字，但可以用鼠标选中复制 -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- 网格：每格左封面右信息，一行放 2~4 本；点卡片任意处勾选，勾选框在右上角 -->
        <DataTemplate x:Key="GridCell">
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,6" Opacity="{Binding RowOpacity}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    MouseLeftButtonUp="Card_Click" Cursor="Hand" ContextMenu="{StaticResource WorkMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="70" Height="98" Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <DockPanel Grid.Column="1">
                        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Bottom">
                                <Run Text="{Binding MonthsText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                <Run Text="{Binding PostedText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding BadgeBrush}" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12"/>
                            </Border>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4,2" ToolTip="打开已发布的画廊" Tag="{Binding Url}" Click="OpenPath_Click"
                                       Visibility="{Binding LinkVisibility}" Icon="{ui:SymbolIcon Open24}"/>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4,2" ToolTip="打开作品文件夹" Tag="{Binding Folder}" Click="OpenPath_Click"
                                       Icon="{ui:SymbolIcon Folder24}"/>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4,2" ToolTip="编辑上传信息（标题、标签）" Click="EditMeta_Click" Icon="{ui:SymbolIcon Edit24}"/>
                        </DockPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Style="{StaticResource LinkTitle}" MouseLeftButtonUp="Title_Click" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" ToolTip="{Binding FullTitle}"/>
                            <TextBlock Text="{Binding AuthorLine}" ToolTip="{Binding WorkDir}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding PagesText, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock><TextBlock Text="{Binding ProblemText}" Visibility="{Binding ProblemVisibility}" Foreground="#E0604F" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding DetailText}"/><TextBlock Text="{Binding NoticeText}" Visibility="{Binding NoticeVisibility}" Foreground="#E0A040" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding DetailText}"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0" MinWidth="0"
                              IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Click="ItemCheck_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GridRow">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GridCell}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- 紧凑行：一行一部作品，勾选框在最右边 -->
        <DataTemplate x:Key="CompactRow">
            <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,4" Opacity="{Binding RowOpacity}"
                    MouseLeftButtonUp="Card_Click" Cursor="Hand" ContextMenu="{StaticResource WorkMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="62" CornerRadius="3" ClipToBounds="True" Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LinkTitle}" MouseLeftButtonUp="Title_Click" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullTitle}"/>
                        <TextBlock Text="{Binding AuthorLine}" ToolTip="{Binding WorkDir}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding PagesText, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </TextBlock><TextBlock Text="{Binding ProblemText}" Visibility="{Binding ProblemVisibility}" Foreground="#E0604F" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding DetailText}"/><TextBlock Text="{Binding NoticeText}" Visibility="{Binding NoticeVisibility}" Foreground="#E0A040" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding DetailText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,6,0">
                        <TextBlock Text="{Binding MonthsText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" ToolTip="原作发布距今"/>
                        <TextBlock Text="{Binding PostedText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" FontSize="11"/>
                        <TextBlock Text="{Binding RefilledText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Transparent" Padding="5,3" ToolTip="编辑上传信息（标题、标签）" Click="EditMeta_Click" Icon="{ui:SymbolIcon Edit24}"/>
                        <ui:Button Appearance="Transparent" Padding="5,3" ToolTip="打开作品文件夹" Tag="{Binding Folder}" Click="OpenPath_Click" Icon="{ui:SymbolIcon Folder24}"/>
                        <ui:Button Appearance="Transparent" Padding="5,3" ToolTip="打开已发布的画廊" Tag="{Binding Url}" Click="OpenPath_Click"
                                   Visibility="{Binding LinkVisibility}" Icon="{ui:SymbolIcon Open24}"/>
                        <Border Style="{StaticResource Badge}" Background="{Binding BadgeBrush}" VerticalAlignment="Center" MinWidth="64" Margin="4,0,2,0">
                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <CheckBox Grid.Column="4" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                              VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="0" Click="ItemCheck_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 大封面卡片：勾选框在右上角 -->
        <DataTemplate x:Key="LargeRow">
            <Border Style="{StaticResource Card}" Opacity="{Binding RowOpacity}" MouseLeftButtonUp="Card_Click" Cursor="Hand" ContextMenu="{StaticResource WorkMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="84" Height="118" CornerRadius="4" ClipToBounds="True" Margin="0,0,14,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LinkTitle}" MouseLeftButtonUp="Title_Click" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" ToolTip="{Binding FullTitle}"/>
                        <TextBlock Text="{Binding AuthorLine}" ToolTip="{Binding WorkDir}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12"><Run Text="{Binding PagesText, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></TextBlock>
                        <TextBlock Text="{Binding ProblemText}" Visibility="{Binding ProblemVisibility}" Foreground="#E0604F" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{Binding NoticeText}" Foreground="#E0A040" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0">
                        <TextBlock Text="原作距今" Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="12" Margin="0,24,0,0"/>
                        <TextBlock Text="{Binding MonthsText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PostedText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="12"/>
                        <TextBlock Text="{Binding RefilledText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="12" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Transparent" Padding="6,3" Margin="0,0,4,0" ToolTip="编辑上传信息（标题、标签）" Click="EditMeta_Click" Icon="{ui:SymbolIcon Edit24}"/>
                            <ui:Button Appearance="Transparent" Padding="6,3" Margin="0,0,4,0" ToolTip="打开作品文件夹" Tag="{Binding Folder}" Click="OpenPath_Click"
                                       Icon="{ui:SymbolIcon Folder24}"/>
                            <ui:Button Appearance="Transparent" Padding="6,3" Margin="0,0,4,0" ToolTip="打开已发布的画廊" Tag="{Binding Url}" Click="OpenPath_Click"
                                       Visibility="{Binding LinkVisibility}" Icon="{ui:SymbolIcon Open24}"/>
                            <Border Style="{StaticResource Badge}" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" MinWidth="0"
                              IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Click="ItemCheck_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle x:Name="Tint" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0"/>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="EH 上传助手">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/EHUploader;component/icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <DockPanel Grid.Column="0" Margin="10,4,6,12">
                <TextBlock x:Name="SideStatus" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="8,2,0,14"/>
                <TextBlock x:Name="SideUpload" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="8,0,0,4"/>
                <StackPanel x:Name="Nav">
                    <ui:Button Style="{StaticResource NavButton}" Tag="0" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Library24" Margin="0,0,12,0"/><TextBlock Text="作品列表"/></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource NavButton}" Tag="1" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,12,0"/><TextBlock Text="上传进度"/></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource NavButton}" Tag="2" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Margin="0,0,12,0"/><TextBlock Text="上传记录"/></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource NavButton}" Tag="3" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Comment24" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="已上传" VerticalAlignment="Center"/>
                            <Border x:Name="MineNewBadge" Height="18" MinWidth="18" CornerRadius="9" Padding="5,0" Margin="10,0,0,0" Background="#C26A00" Visibility="Collapsed" VerticalAlignment="Center">
                                <!-- InkText 按数字笔画的实际范围居中，任何数字、任何缩放都在圆心 -->
                                <local:InkText x:Name="MineNewText" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource NavButton}" Tag="4" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel>
                    </ui:Button>
                </StackPanel>
            </DockPanel>

            <!-- pages -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Header" Grid.Row="0" FontSize="26" FontWeight="SemiBold" Margin="24,6,24,10"/>

                <Border x:Name="PageLayer" Grid.Row="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                    <Grid>
                        <!-- 0 作品列表 -->
                        <DockPanel x:Name="PageWorks" Margin="24,12,24,0">
                            <StackPanel DockPanel.Dock="Top">
                                <Border Style="{StaticResource Card}" Padding="16,10">
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,28,4">
                                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="回填时间晚于" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       ToolTip="只列出这一天及之后回填的 cbz（按 cbz 文件修改时间）"/>
                                            <DatePicker x:Name="RefillDate" Width="160" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,28,4">
                                            <ui:SymbolIcon Symbol="Clock24" FontSize="20" Margin="0,0,10,0"/>
                                            <TextBlock Text="原作发布满" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       ToolTip="满足的作品自动勾选；不满足的变暗，仍可手动勾选"/>
                                            <ui:NumberBox x:Name="MinMonths" Minimum="0" Maximum="240" SmallChange="1" LargeChange="3" MaxDecimalPlaces="1" Width="120" ClearButtonEnabled="False"
                                                          ValueChanged="MinMonths_ValueChanged"/>
                                            <TextBlock Text="个月才上传" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ui:Button x:Name="ScanButton" Content="扫描" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" MinWidth="96" Margin="0,4"
                                                   Click="Scan_Click"/>
                                    </WrapPanel>
                                </Border>
                                <DockPanel Margin="2,6,0,8">
                                    <ui:ProgressRing x:Name="ScanRing" DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ComboBox x:Name="FilterBox" MinWidth="130" Margin="0,0,10,0" SelectionChanged="Filter_Changed" ToolTip="只显示一部分作品">
                                            <ComboBoxItem Content="全部待上传"/>
                                            <ComboBoxItem Content="只看符合"/>
                                            <ComboBoxItem Content="只看已勾选"/>
                                            <ComboBoxItem Content="只看需处理"/>
                                            <ComboBoxItem Content="只看已上传"/>
                                            <ComboBoxItem Content="只看已排除"/>
                                        </ComboBox>
                                        <ComboBox x:Name="ViewBox" MinWidth="120" Margin="0,0,10,0" SelectionChanged="View_Changed" ToolTip="列表的显示方式">
                                            <ComboBoxItem Content="网格"/>
                                            <ComboBoxItem Content="紧凑列表"/>
                                            <ComboBoxItem Content="大封面"/>
                                        </ComboBox>
                                        <ui:Button Content="按月数重新勾选" Margin="0,0,6,0" Click="SelectEligible_Click"/>
                                        <ui:Button Content="全不选" Margin="0,0,6,0" Click="SelectNone_Click"/>
                                        <ui:Button Content="给勾选的加标签" Icon="{ui:SymbolIcon Tag24}" Click="AddTagsToSelected_Click" ToolTip="给勾选的作品统一加上一些标签，上传时一起加上（已有的不重复）"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="选择回填日期后点「扫描」。"/>
                                </DockPanel>
                            </StackPanel>
                            <ItemsControl x:Name="WorkList" ItemTemplate="{StaticResource CompactRow}" SizeChanged="WorkList_SizeChanged"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12" Focusable="False">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>

                        <!-- 1 上传进度 -->
                        <DockPanel x:Name="PageProgress" Margin="24,12,24,0" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top">
                                <ui:InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>
                                <ui:CardControl Icon="{ui:SymbolIcon ArrowUpload24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="总进度" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="OverallText" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="还没有开始上传"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar x:Name="OverallBar" Width="260" Height="6" Maximum="100" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OverallPercent" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </ui:CardControl>
                                <ui:CardControl x:Name="CurrentCard" Icon="{ui:SymbolIcon DocumentArrowUp20}" Visibility="Collapsed">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock x:Name="CurrentTitle" Text="当前作品" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="CurrentStage" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="CurrentDetail" FontSize="12" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Style.Triggers>
                                                            <!-- 没有详细信息时整行收起，卡片不留空白 -->
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar x:Name="CurrentBar" Width="260" Height="6" Maximum="100" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CurrentPercent" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </ui:CardControl>
                                <TextBlock Text="队列" Style="{StaticResource Section}"/>
                                <TextBlock x:Name="QueueEmpty" Style="{StaticResource Muted}" Margin="2,0,0,0"
                                           Text="还没有上传任务。在「作品列表」里勾选作品后，点右下角「开始上传」。"/>
                            </StackPanel>
                            <!-- 队列和运行日志上下分栏同时显示，中间的分隔线可以拖动；日志可以收起 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="100"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="LogRow" Height="200"/>
                                </Grid.RowDefinitions>
                                <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                                              ToolTip="上下拖动调整队列和日志的高度"/>
                                <Border Grid.Row="1" Height="3" Width="48" CornerRadius="2" IsHitTestVisible="False" HorizontalAlignment="Center"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <DockPanel Grid.Row="2">
                                    <DockPanel DockPanel.Dock="Top" Margin="2,2,0,6">
                                        <ui:Button x:Name="LogToggle" DockPanel.Dock="Right" Content="收起" Appearance="Transparent" Padding="10,3"
                                                   Icon="{ui:SymbolIcon ChevronDown24}" Click="LogToggle_Click"/>
                                        <TextBlock Text="运行日志" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"/>
                                </DockPanel>
                            <ScrollViewer x:Name="QueueScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="8" ContextMenu="{StaticResource WorkMenu}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="220"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="56" CornerRadius="3" ClipToBounds="True" Margin="0,0,12,0"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource LinkTitle}" MouseLeftButtonUp="Title_Click" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding QueueStatus}" Foreground="{Binding QueueBrush}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <ProgressBar Width="150" Height="4" Maximum="100" Value="{Binding QueuePercent}" IsIndeterminate="{Binding QueueBusy}" VerticalAlignment="Center"/>
                                                        <ui:Button Appearance="Transparent" Padding="6,3" Margin="6,0,0,0" ToolTip="打开已发布的画廊" Tag="{Binding Url}" Click="OpenPath_Click"
                                                                   Visibility="{Binding LinkVisibility}" Icon="{ui:SymbolIcon Open24}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </DockPanel>

                        <!-- 2 上传记录 -->
                        <DockPanel x:Name="PageHistory" Margin="24,12,24,12" Visibility="Collapsed">
                            <TextBlock x:Name="HistorySummary" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Click="RefreshHistory_Click"/>
                                <ui:Button Content="打开日志文件夹" Icon="{ui:SymbolIcon Folder24}" Click="OpenLogs_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原画廊" Binding="{Binding SourceGid}" Width="90"/>
                                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150"/>
                                    <DataGridTextColumn Header="完成时间" Binding="{Binding Finished}" Width="140"/>
                                    <DataGridTextColumn Header="未生效标签" Binding="{Binding MissingTags}" Width="220">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="画廊" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Appearance="Transparent" Padding="6,2" Tag="{Binding Url}" Click="OpenPath_Click"
                                                           Visibility="{Binding LinkVisibility}" Icon="{ui:SymbolIcon Open24}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- 3 已上传 -->
                        <DockPanel x:Name="PageMine" Margin="24,12,24,0" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top">
                                <ui:InfoBar x:Name="MineBar" IsOpen="False" IsClosable="True" Severity="Warning" Margin="0,0,0,8"/>
                                <DockPanel Margin="2,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox x:Name="OnlyNew" Content="只看有新评论" Margin="0,0,12,0" Click="OnlyNew_Click"/>
                                        <ui:Button x:Name="MineAddTags" Content="批量补标签" Icon="{ui:SymbolIcon Tag24}" Margin="0,0,6,0" Click="MineAddTags_Click" ToolTip="给已发布的画廊补标签，已有的自动跳过"/>
                                        <ui:Button Content="全部标为已读" Margin="0,0,6,0" Click="MarkAllRead_Click"/>
                                        <ui:Button x:Name="MineRefresh" Content="刷新评论" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="MineRefresh_Click"/>
                                    </StackPanel>
                                    <ui:ProgressRing x:Name="MineRing" DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="MineSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="打开这一页时会读取「我的上传」和各画廊的最新评论。"/>
                                </DockPanel>
                            </StackPanel>
                            <ItemsControl x:Name="MineList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12" Focusable="False">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="10" ContextMenu="{StaticResource GalleryMenu}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="64" Height="90" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0" Background="#C26A00" Visibility="{Binding NewVisibility}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding NewText}" Foreground="White" FontSize="12"/>
                                                            </Border>
                                                            <ui:Button Content="标为已读" Padding="8,3" Margin="0,0,4,0" Visibility="{Binding ReadButtonVisibility}" Click="MarkRead_Click"/>
                                                            <ui:Button Content="写评论" Padding="8,3" Margin="0,0,4,0" Icon="{ui:SymbolIcon CommentAdd24}" Click="ToggleEditor_Click"/>
                                                            <ui:Button Appearance="Transparent" Padding="5,3" ToolTip="在浏览器里打开画廊" Tag="{Binding Url}" Click="OpenPath_Click" Icon="{ui:SymbolIcon Open24}"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource LinkTitle}" MouseLeftButtonUp="Title_Click" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                            <TextBlock Text="{Binding En}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,0">
                                                                <Run Text="{Binding Info, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CommentsHeader, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Comments}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,4" Padding="10,5" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" ContextMenu="{StaticResource CommentMenu}">
                                                                    <Grid>
                                                                        <Border Width="3" HorizontalAlignment="Left" Margin="-10,-5,0,-5" CornerRadius="2" Background="#C26A00" Visibility="{Binding NewVisibility}"/>
                                                                        <StackPanel>
                                                                            <TextBlock FontSize="12">
                                                                                <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                                <Run Text="{Binding PostedText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                                <Run Text="{Binding Score, Mode=OneWay}" Foreground="{Binding ScoreBrush, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" MaxHeight="120" Margin="-2,2,0,0"/>
                                                                        </StackPanel>
                                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="3" Padding="5,0" Background="#C26A00" Visibility="{Binding NewVisibility}">
                                                                            <TextBlock Text="新" Foreground="White" FontSize="11"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Visibility="{Binding EditorVisibility}" Margin="0,6,0,0">
                                                        <ui:TextBox Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                    MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" PlaceholderText="写一条评论（至少 10 个字符）"/>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <ui:Button Content="取消" Margin="0,0,6,0" Click="ToggleEditor_Click"/>
                                                                <ui:Button Content="发送评论" Appearance="Primary" IsEnabled="{Binding CanSend}" Icon="{ui:SymbolIcon Send24}" Click="SendComment_Click"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SendStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- 4 设置 -->
                        <ScrollViewer x:Name="PageSettings" Padding="24,6,24,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="账号" Style="{StaticResource Section}"/>
                                <ui:CardControl Icon="{ui:SymbolIcon Person24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="e-hentai 登录"/>
                                            <TextBlock x:Name="LoginState" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button x:Name="LoginButton" Content="打开登录窗口" Icon="{ui:SymbolIcon PersonArrowRight24}" Click="Login_Click"/>
                                </ui:CardControl>

                                <TextBlock Text="上传内容" Style="{StaticResource Section}"/>
                                <ui:CardControl Icon="{ui:SymbolIcon Tag24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="额外标签"/>
                                            <TextBlock Text="原画廊的标签会全部复制（language 除外），再补上这里的标签；逗号分隔" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox x:Name="ExtraTags" Width="320"/>
                                </ui:CardControl>
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <ui:SymbolIcon Symbol="TextDescription24" Margin="0,0,14,0" FontSize="20"/>
                                            <TextBlock Text="简介（上传者评论）" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="每部画廊的上传者简介。留空表示不填写；{raw} 上传时会换成这部作品未翻译原画廊的链接（删掉就不加）；作品文件夹里有 upload_note.txt 时，其内容会放在简介最前面。" Style="{StaticResource Muted}" Margin="34,0,0,8" TextWrapping="Wrap"/>
                                        <ui:TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="300"
                                                    VerticalScrollBarVisibility="Auto" Margin="34,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <ComboBox x:Name="ShareModeBox" DockPanel.Dock="Right" MinWidth="200">
                                                <ComboBoxItem Content="每次上传只在第一部下面发"/>
                                                <ComboBoxItem Content="每部都发"/>
                                                <ComboBoxItem Content="不发"/>
                                            </ComboBox>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Comment24" Margin="0,0,14,0" FontSize="20"/>
                                                <TextBlock Text="经验分享评论" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="发布并加完标签后，在画廊下面单独发表的一条评论。每部是否发过会记录下来，续传不会重复发。" Style="{StaticResource Muted}" Margin="34,0,0,8"/>
                                        <ui:TextBox x:Name="ShareBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="420"
                                                    VerticalScrollBarVisibility="Auto" Margin="34,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <ui:SymbolIcon Symbol="ShieldError24" Margin="0,0,14,0" FontSize="20"/>
                                            <TextBlock Text="原画廊评论检测" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="扫描时读取原画廊的评论（含原上传者简介），出现下面的词就先拦下并弹窗提示，看过原评论确认后可以放行。词之间用逗号或换行分隔。" Style="{StaticResource Muted}" Margin="34,0,0,8"/>
                                        <TextBlock Text="拦截词（禁止、勿扰、已预定之类）" Margin="34,0,0,4"/>
                                        <ui:TextBox x:Name="BlockWords" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="34,0,0,8"/>
                                        <TextBlock Text="待确认词（需要看原评论判断，英文词按整词匹配、不分大小写）" Margin="34,0,0,4"/>
                                        <ui:TextBox x:Name="ReviewWords" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="34,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="运行" Style="{StaticResource Section}"/>
                                <ui:CardControl Icon="{ui:SymbolIcon Folder24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="漫画根目录"/>
                                            <TextBlock Text="扫描这个目录下的日期批次；已上传、老文件等目录会跳过" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox x:Name="RootPath" Width="340" Margin="0,0,8,0"/>
                                        <ui:Button Content="浏览…" Click="BrowseRoot_Click"/>
                                    </StackPanel>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Globe24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="浏览器程序"/>
                                            <TextBlock Text="Chromium 内核浏览器的 exe，使用独立的用户资料，不影响日常浏览；留空用 Edge" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox x:Name="BrowserPath" Width="340" Margin="0,0,8,0"/>
                                        <ui:Button Content="浏览…" Click="BrowseBrowser_Click"/>
                                    </StackPanel>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Timer24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="每部之间的间隔（秒）"/>
                                            <TextBlock Text="上传完一部后，在这个范围内随机等一会儿再传下一部，避免连续刷屏" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:NumberBox x:Name="GapMin" Minimum="0" Maximum="3600" SmallChange="10" MaxDecimalPlaces="0" Width="140" ClearButtonEnabled="False"/>
                                        <TextBlock Text="到" VerticalAlignment="Center" Margin="8,0"/>
                                        <ui:NumberBox x:Name="GapMax" Minimum="0" Maximum="3600" SmallChange="10" MaxDecimalPlaces="0" Width="140" ClearButtonEnabled="False"/>
                                    </StackPanel>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="点关闭按钮时缩到托盘"/>
                                            <TextBlock Text="窗口隐藏到右下角托盘继续运行，上传不会中断；双击托盘图标恢复，右键托盘图标可以退出" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="CloseToTray" Click="CloseToTray_Click"/>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Header="上传时隐藏浏览器窗口">
                                    <ui:ToggleSwitch x:Name="Headless"/>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon DataUsage24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="单批上传上限（MB）"/>
                                            <TextBlock Text="网站限制单次不超过 500MB；超过的 cbz 会自动分批" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:NumberBox x:Name="BatchMb" Minimum="50" Maximum="480" SmallChange="10" MaxDecimalPlaces="0" MinWidth="140" ClearButtonEnabled="False"/>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Code24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Python"/>
                                            <TextBlock Text="运行上传脚本用的 python.exe，默认使用 PATH 里的 python" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox x:Name="PythonPath" Width="340"/>
                                </ui:CardControl>

                                <TextBlock Text="外观" Style="{StaticResource Section}"/>
                                <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Header="主题">
                                    <ComboBox x:Name="ThemeBox" MinWidth="180" SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="日间（浅色）"/>
                                        <ComboBoxItem Content="夜间（深色）"/>
                                    </ComboBox>
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Blur24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="窗口背景"/>
                                            <TextBlock Text="云母：取桌面壁纸的颜色；亚克力：半透明，透出后面模糊的窗口" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="BackdropBox" MinWidth="180" SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="云母"/>
                                        <ComboBoxItem Content="亚克力（半透明）"/>
                                        <ComboBoxItem Content="无"/>
                                    </ComboBox>
                                </ui:CardControl>
                                <ui:CardControl x:Name="TintCard" Icon="{ui:SymbolIcon Color24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="亚克力遮罩不透明度"/>
                                            <TextBlock Text="深色主题用深灰、浅色主题用浅灰盖在半透明背景上；越大越不透明" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="TintSlider" Width="200" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Tint_Changed"/>
                                        <TextBlock x:Name="TintText" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </ui:CardControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- footer -->
                <Border Grid.Row="2" Padding="24,10,24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel MinHeight="34">
                        <StackPanel x:Name="FooterWorks" DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button x:Name="UploadButton" Content="开始上传" Appearance="Primary" MinWidth="140" Icon="{ui:SymbolIcon ArrowUpload24}" Click="Upload_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="FooterProgress" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:Button x:Name="StopButton" Content="停止上传" Icon="{ui:SymbolIcon Stop24}" MinWidth="120" Click="Stop_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="FooterSettings" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:Button Content="保存" Appearance="Primary" MinWidth="96" Click="Save_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="FooterStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
